{
  "name": "pc-quote-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vite build --outDir /tmp/pc-check-build",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build:check",
    "preview": "vite preview",
    "build:pc-data": "node ../scripts/build_pc_data.js",
    "sync:pc-data": "node ../scripts/sync_processed_to_public_data.js",
    "download:pc-data": "python ../scripts/download_pc_datasets.py",
    "pc-data:all": "npm run download:pc-data && npm run build:pc-data && npm run sync:pc-data",
    "test": "vitest run --exclude src/lib/postBuildAssertion.test.js",
    "test:artifacts": "vitest run src/lib/artifactContract.test.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "baseline-browser-mapping": "^2.11.7",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
